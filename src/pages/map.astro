---
import Base from '../layouts/Base.astro';
import Letter from '../components/Letter.astro';
---
<Base title="Map" current="map" description="The whole show as one picture: every line is one question the show keeps coming back to.">
  <div class="map-head">
    <div class="ep-head">
      <span class="kick">map</span>
      <h1 class="h2">the whole show as one picture</h1>
      <p class="body">every line is one question the show keeps coming back to. pick a line, then tap any stop or title to read the episode.</p>
    </div>
  </div>
  <div class="map-lines">
    <div class="chips-row" id="map-chips"></div>
    <div class="maplegend">
      <span class="lab"><i class="fm basics"></i>basics</span>
      <span class="lab"><i class="fm layer"></i>layer</span>
      <span class="lab"><i class="fm pulse"></i>pulse</span>
      <span class="lab">two lines on one stop = an interchange</span>
      <span class="lab sum" id="map-sum"></span>
    </div>
  </div>
  <div class="map-wrap">
    <canvas class="map" id="map1" aria-label="Metro map of plain strata episodes"></canvas>
    <div class="pop" id="map-pop" hidden></div>
  </div>

  <Letter line="get every new stop in your inbox." />
</Base>

<script>
  import { initMap } from '../scripts/strata.js';
  initMap();
</script>
