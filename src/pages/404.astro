---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <div class="ep-top">
    <div class="ep-head">
      <span class="kick">404</span>
      <h1 class="h2">this stop is not on the map</h1>
      <p class="body">the page you asked for does not exist. go back to the <a href="/" style="border-bottom:1px solid var(--g600)">question tree</a> or open the <a href="/map/" style="border-bottom:1px solid var(--g600)">map</a>.</p>
    </div>
  </div>
</Base>
